{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smalikiitkgp.github.io/data/SOURCES.schema.json",
  "title": "Dataset registry for the Cosmos site",
  "description": "A dataset may only be marked license_status: verified by a human who has read the provider's terms and recorded license_url, verified_by, verified_on. Only datasets with license_status: verified may be shipped as data. Tests/sources.test.mjs enforces these rules without needing a JSON-schema library.",
  "type": "object",
  "required": ["_policy", "datasets"],
  "properties": {
    "_policy": { "type": "string" },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "what", "used_in", "license_status", "ship"],
        "properties": {
          "id":            { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "what":          { "type": "string" },
          "citation":      { "type": "string" },
          "doi":           { "type": "string", "pattern": "^10\\.[0-9]{4,}/" },
          "arxiv":         { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{4,5}(v[0-9]+)?$" },
          "used_in":       { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "ship":          { "enum": ["data", "link_only", "derived"] },
          "values_verified": { "type": "boolean" },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "verified"],
              "properties": {
                "name":     { "type": "string" },
                "table":    { "type": "string" },
                "verified": { "type": "boolean" },
                "verified_on": { "type": "string", "description": "ISO-8601 date" }
              }
            }
          },
          "license_status": { "enum": ["to_verify", "verified", "rejected"] },
          "license":        { "type": "string" },
          "license_url":    { "type": "string", "description": "http(s) URL to the provider's terms" },
          "verified_by":    { "type": "string", "description": "Human who read the terms" },
          "verified_on":    { "type": "string", "description": "ISO-8601 date" },
          "notes":          { "type": "string" },
          "todo":           { "type": "string" }
        }
      }
    }
  }
}